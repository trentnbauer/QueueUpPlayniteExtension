<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Playnite 10 plugins target .NET Framework 4.6.2 (Playnite 11 moves to .NET 10 - see #4,
         this extension stays on the v10 SDK until that migration happens). -->
    <TargetFramework>net462</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>QueueUpExporter</AssemblyName>
    <RootNamespace>QueueUpExporter</RootNamespace>
    <!-- Playnite's plugin loader (v10) only allows one version of a given assembly to be loaded
         across every installed plugin - referencing our own copy of a package Playnite already
         ships (Newtonsoft.Json, etc.) risks a version mismatch. Nothing here needs one: the SDK's
         own Playnite.SDK.Data.Serialization covers JSON, so no extra PackageReference beyond the
         reference-assemblies shim needed to cross-compile net462 on a non-Windows build machine. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="PlayniteSDK" Version="6.15.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not used directly - IDialogsFactory.ShowMessage's overload set includes WPF's
         MessageBoxImage/MessageBoxResult, so the compiler needs this resolvable even for the plain
         single-string overload actually called here. -->
    <Reference Include="PresentationFramework" />
    <!-- System.Windows.Application.Current.Dispatcher - marshals the update-check notification
         back to the UI thread from the background thread it's computed on. -->
    <Reference Include="WindowsBase" />
    <!-- Not implied by default for a net462 SDK-style project - needed for HttpClient (push to
         QueueUp, #7). -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
